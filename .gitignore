# ---- data ----
# Raw downloads are reproducible via `make data`; never commit them.
data/raw/
data/interim/
*.zip
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Processed outputs are regenerable from the pipeline
data/processed/*.parquet
data/processed/*.csv

# ...but the SNAPSHOT is deliberately committed. It is what lets the app run
# on a machine with no Postgres — a cloud deployment, or a fresh clone. Roughly
# 2 MB, derived, and regenerable with `make snapshot`.
!data/processed/snapshot/
!data/processed/snapshot/*

# ---- secrets / env ----
.env
*.pgpass

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# ---- postgres volume (docker) ----
pgdata/

# ---- editors / os ----
.vscode/
.idea/
.DS_Store
*.swp

# ---- keep the directory structure ----
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!reports/.gitkeep
