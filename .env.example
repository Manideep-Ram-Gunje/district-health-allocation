# Copy to .env  ->  cp .env.example .env
# .env is gitignored. These defaults are fine for a local lab machine.

PGUSER=dhia
PGPASSWORD=dhia
PGDATABASE=dhia
PGHOST=localhost
PGPORT=5433

# Optional: overrides everything above if set.
# DATABASE_URL=postgresql+psycopg2://dhia:dhia@localhost:5433/dhia
