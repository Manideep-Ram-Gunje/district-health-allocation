# Copy to .env  ->  cp .env.example .env
# .env is gitignored. These defaults are fine for a local lab machine.

PGUSER=dhia
PGPASSWORD=dhia
PGDATABASE=dhia
PGHOST=localhost
# 5432 = native apt install (the default on this machine).
# If you ever switch to the docker-compose path, change this to 5433 —
# compose deliberately publishes on 5433 so it cannot collide with a
# system Postgres already listening on 5432.
PGPORT=5432

# Optional: overrides everything above if set.
# NOTE: if you set DATABASE_URL, spell the port out explicitly. libpq falls
# back to the PGPORT environment variable for any connection parameter the URL
# omits, so a portless DATABASE_URL will silently inherit PGPORT from this file
# and connect to the wrong server. Cost us a debugging cycle; don't repeat it.
# DATABASE_URL=postgresql+psycopg2://dhia:dhia@localhost:5432/dhia
